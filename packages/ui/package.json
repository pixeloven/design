{
  "name": "@pixeloven/ui",
  "version": "0.1.0",
  "description": "Native React controls for the PixelOven design system.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": ["dist", "README.md", "CHANGELOG.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "lint": "biome lint .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "pnpm build && pnpm typecheck && tsx --test test/*.test.tsx && node --test test/*.test.mjs",
    "prepublishOnly": "pnpm lint && pnpm test"
  },
  "peerDependencies": {
    "@pixeloven/tokens": ">=0.6.0 <0.7.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@pixeloven/tokens": "workspace:*",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.19.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "jsdom": "26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixeloven/design.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
