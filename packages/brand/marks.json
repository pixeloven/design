  ],
  "assetContract": {
    "version": 1,
    "inkToken": "text.base",
    "backgroundToken": "surface.bg",
    "appearance": "light means dark ink on a light ground; dark means light ink on a dark ground",
    "lockup": {
      "font": "IBM Plex Sans",
      "weight": 500,
      "fontSize": 40,
      "letterSpacingEm": -0.025,
      "gap": 12
    },
    "maskable": {
      "scale": 0.64,
      "safeZoneRadius": 0.4
    }
  }
}
