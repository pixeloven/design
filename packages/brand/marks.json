{
  "$comment": [
    "The mark registry. A mark that is not listed here is not shipped — the tests",
    "assert the directory and this file agree in both directions, so an orphan SVG",
    "or a dangling entry fails the build rather than quietly half-existing.",
    "",
    "`tier` is the brand relationship, and it is the thing that decides how much a",
    "mark may vary:",
    "  parent   PixelOven itself. One only.",
    "  product  a thing we ship and name (Lattice, Warden). Own figure, shared palette.",
    "  family   a member of a named set (the *-axi tools). Shares a figure motif with",
    "           its siblings and differs by one element."
  ],
  "marks": [
    {
      "id": "pixeloven",
      "name": "PixelOven",
      "tier": "parent",
      "file": "marks/pixeloven.svg",
      "figure": "a heavy geometric P on a dark tile with a sparkle — the established org emblem, redrawn as paths",
      "note": "kept from the existing brand rather than redesigned; monochrome by intent so the parent does not compete with its products for colour",
      "variants": {
        "solid": {
          "source": "sources/solid/pixeloven.svg",
          "figure": "a faceted P with a cutout bowl",
          "usage": "primary headers and name lockups",
          "clearSpace": {
            "viewBoxUnits": 8,
            "relativeTo": "outside the visible artwork; packaged SVG padding does not replace clear space"
          },
          "minimumSize": {
            "markCssPx": 24,
            "lockupHeightCssPx": 32
          },
          "assets": {
            "light": {
              "mark": "dist/assets/pixeloven/solid/light/mark.svg",
              "lockup": "dist/assets/pixeloven/solid/light/lockup.svg"
            },
            "dark": {
              "mark": "dist/assets/pixeloven/solid/dark/mark.svg",
              "lockup": "dist/assets/pixeloven/solid/dark/lockup.svg"
            }
          }
        },
        "inset": {
          "source": "sources/inset/pixeloven.svg",
          "figure": "a faceted tile with a P cutout and a solid counter",
          "usage": "favicons, app icons and avatars",
          "clearSpace": {
            "viewBoxUnits": 8,
            "relativeTo": "outside the visible artwork; packaged SVG padding does not replace clear space"
          },
          "minimumSize": {
            "markCssPx": 16,
            "maskableCssPx": 48
          },
          "assets": {
            "light": {
              "mark": "dist/assets/pixeloven/inset/light/mark.svg",
              "favicon": {
                "svg": "dist/assets/pixeloven/inset/light/favicon.svg",
                "png16": "dist/assets/pixeloven/inset/light/favicon-16.png",
                "png32": "dist/assets/pixeloven/inset/light/favicon-32.png"
              },
              "app": {
                "svg": "dist/assets/pixeloven/inset/light/app.svg",
                "png180": "dist/assets/pixeloven/inset/light/app-180.png",
                "png192": "dist/assets/pixeloven/inset/light/app-192.png",
                "png512": "dist/assets/pixeloven/inset/light/app-512.png"
              },
              "maskable": {
                "svg": "dist/assets/pixeloven/inset/light/maskable.svg",
                "png192": "dist/assets/pixeloven/inset/light/maskable-192.png",
                "png512": "dist/assets/pixeloven/inset/light/maskable-512.png"
              }
            },
            "dark": {
              "mark": "dist/assets/pixeloven/inset/dark/mark.svg",
              "favicon": {
                "svg": "dist/assets/pixeloven/inset/dark/favicon.svg",
                "png16": "dist/assets/pixeloven/inset/dark/favicon-16.png",
                "png32": "dist/assets/pixeloven/inset/dark/favicon-32.png"
              },
              "app": {
                "svg": "dist/assets/pixeloven/inset/dark/app.svg",
                "png180": "dist/assets/pixeloven/inset/dark/app-180.png",
                "png192": "dist/assets/pixeloven/inset/dark/app-192.png",
                "png512": "dist/assets/pixeloven/inset/dark/app-512.png"
              },
              "maskable": {
                "svg": "dist/assets/pixeloven/inset/dark/maskable.svg",
                "png192": "dist/assets/pixeloven/inset/dark/maskable-192.png",
                "png512": "dist/assets/pixeloven/inset/dark/maskable-512.png"
              }
            }
          }
        }
      }
    },
