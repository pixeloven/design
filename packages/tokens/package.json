{
  "name": "@pixeloven/tokens",
  "version": "0.6.0",
  "description": "PixelOven design tokens — the source of truth for every surface colour, and for the scales a surface is built out of.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/tokens.js",
  "types": "./dist/tokens.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./source": "./src/tokens.json",
    "./tokens-dark.css": "./dist/tokens-dark.css",
    "./tokens-light.css": "./dist/tokens-light.css",
    "./themes": {
      "types": "./dist/themes.d.ts",
      "default": "./dist/themes.js"
    },
    "./themes.css": "./dist/themes.css",
    "./themes.json": "./dist/themes.json",
    "./themes/source": "./src/themes.json"
  },
  "files": [
    "dist",
    "src/tokens.json",
    "CHANGELOG.md",
    "src/themes.json",
    "README.md"
  ],
  "scripts": {
    "build": "node src/build.mjs",
    "test": "node --test",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "node src/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixeloven/design.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
